<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".fragments.SettingsFragment">

    <!-- Scrollable container for settings -->
    <ScrollView
        android:id="@+id/scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvThemeSettings"
                android:layout_width="325dp"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_settings"
                android:padding="16dp"
                android:text="Settings"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 🔔 Notification Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotificationSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/dark_on_background"
                    android:padding="16dp">

                    <!-- Title inside dark background -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Notification Settings"
                        android:textColor="@color/dark_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Enable Notifications Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Enable Notifications"
                            android:textColor="@color/dark_on_primary"
                            android:textSize="16sp"/>

                        <Switch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Vibrate Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vibration"
                            android:textColor="@color/dark_on_primary"
                            android:textSize="16sp"/>

                        <Switch
                            android:id="@+id/switchVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Notification Sound -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sound"
                            android:textColor="@color/dark_on_primary"
                            android:textSize="16sp"/>

                        <Switch
                            android:id="@+id/switchSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- THEME SETTINGS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThemeSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/cardview_light_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvColourThemeSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme Settings"
                        android:textColor="@color/dark_on_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 👤 Account Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccountSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/cardview_light_background"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Account Settings"
                        android:textColor="@color/dark_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnUpdateProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Update Profile Info"
                        style="?attr/materialButtonOutlinedStyle"
                        android:textColor="@color/dark_on_primary"/>

                    <Button
                        android:id="@+id/btnChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change Password"
                        android:layout_marginTop="8dp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:textColor="@color/dark_on_primary"/>

                    <Button
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delete Account"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/holo_red_dark"
                        style="?attr/materialButtonOutlinedStyle"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Other Sections -->
            <TextView
                android:id="@+id/tvPrivacySecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy and Security"
                android:textSize="18sp"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/tvSupportHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Support / Help"
                android:textSize="18sp"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
