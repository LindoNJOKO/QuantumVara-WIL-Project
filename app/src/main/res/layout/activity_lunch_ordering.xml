<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true"
    tools:context=".LunchOrdering">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_background"
            android:padding="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvLunchTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lunch_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lunch_subtitle"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="?attr/colorOnBackground"
                android:alpha="0.7" />
        </LinearLayout>

        <!-- Monday -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="1dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_monday"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="2dp" />

                <CheckBox
                    android:id="@+id/cbMondayChicken"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/monday_chicken"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbMondayVeggie"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/monday_veggie"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tuesday -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="1dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_tuesday"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="2dp" />

                <CheckBox
                    android:id="@+id/cbTuesdayPasta"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/tuesday_pasta"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbTuesdaySoup"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/tuesday_soup"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Wednesday -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="1dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_wednesday"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="2dp" />

                <CheckBox
                    android:id="@+id/cbWednesdayBeef"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/wednesday_beef"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbWednesdayFruit"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/wednesday_fruit"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thursday -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="1dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_thursday"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="2dp" />

                <CheckBox
                    android:id="@+id/cbThursdayFish"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/thursday_fish"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbThursdayVeggie"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/thursday_veggie"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Friday -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="1dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_friday"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="2dp" />

                <CheckBox
                    android:id="@+id/cbFridayPizza"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/friday_pizza"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbFridaySoup"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:maxWidth="320dp"
                    android:gravity="center_vertical"
                    android:text="@string/friday_soup"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveLunchOrder"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:text="@string/save_button"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp" />

    </LinearLayout>
</ScrollView>
