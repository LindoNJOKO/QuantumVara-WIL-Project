<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/colorBackground"
    tools:context=".LunchOrdering">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvLunchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Creche Lunch Menu"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="20dp"/>

        <!-- Monday -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monday"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"/>

        <CheckBox
            android:id="@+id/cbMondayChicken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chicken and Rice"/>

        <CheckBox
            android:id="@+id/cbMondayVeggie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vegetable Stew"/>

        <!-- Tuesday -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tuesday"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"/>

        <CheckBox
            android:id="@+id/cbTuesdayPasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mac and Cheese"/>

        <CheckBox
            android:id="@+id/cbTuesdaySoup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomato Soup and Bread"/>

        <!-- Wednesday -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wednesday"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"/>

        <CheckBox
            android:id="@+id/cbWednesdayBeef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beef Stew and Rice"/>

        <CheckBox
            android:id="@+id/cbWednesdayFruit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fruit Salad and Yogurt"/>

        <!-- Thursday -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thursday"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"/>

        <CheckBox
            android:id="@+id/cbThursdayFish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fish Fingers and Chips"/>

        <CheckBox
            android:id="@+id/cbThursdayVeggie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vegetable Pasta"/>

        <!-- Friday -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Friday"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"/>

        <CheckBox
            android:id="@+id/cbFridayPizza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mini Pizza"/>

        <CheckBox
            android:id="@+id/cbFridaySoup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pumpkin Soup"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveLunchOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Lunch Order"
            android:layout_marginTop="20dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
