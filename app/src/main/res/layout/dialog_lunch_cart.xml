<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review Your Order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Cart Items Container -->
        <LinearLayout
            android:id="@+id/llCartItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnBackground"
            android:alpha="0.2"
            android:layout_marginVertical="8dp" />

        <!-- Total -->
        <TextView
            android:id="@+id/tvDialogTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: R 0.00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:gravity="end"
            android:layout_marginBottom="16dp" />

        <!-- Special Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/dark_on_background"
            android:hint="Special Instructions (Optional)"
            app:placeholderText="e.g., No onions, extra sauce, allergies, etc."
            app:placeholderTextColor="@color/dark_on_background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpecialNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_on_background"
                android:minLines="3"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>


    </LinearLayout>

</ScrollView>