<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".fragments.AdminDashboardFragment">

    <!-- Title and Chat Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/AdminDashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="35dp"
            android:text="Admin Tools"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <!-- Chat Button -->
        <ImageButton
            android:id="@+id/btnChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chats"
            android:src="@drawable/ic_chat" />

    </RelativeLayout>

    <!-- Notification Feed Title -->
    <TextView
        android:id="@+id/notification_feed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="35dp"
        android:text="Notification Feed"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground" />

    <!-- RecyclerView for Announcements -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAnnouncements"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false" />

    <!-- Action Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginBottom="16dp">

        <!-- Add Notification Button -->
        <Button
            android:id="@+id/btnAddNotification"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_button"
            android:elevation="6dp"
            android:text="Add Notification"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <!-- Extended Floating Action Button (Create Event) -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabCreateEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:icon="@drawable/ic_link_add"
            android:text="Create Event"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:elevation="8dp"
            android:paddingHorizontal="24dp"
            app:iconTint="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>
