<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/cart_item_background"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvCartMealName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grilled Chicken Burger"
                android:textSize="16sp"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvCartMealPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R 35.00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRemoveFromCart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove item" />

</LinearLayout>