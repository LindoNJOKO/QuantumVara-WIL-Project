<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Success Badge -->
            <TextView
                android:id="@+id/receiptBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✓"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/badge_circle"
                android:layout_marginEnd="16dp"/>

            <!-- Receipt Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/receiptItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuition Payment"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212529"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/receiptDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 Oct 2025, 14:30"
                    android:textSize="14sp"
                    android:textColor="#6C757D"/>

            </LinearLayout>

            <!-- Amount -->
            <TextView
                android:id="@+id/receiptAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R100.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#28A745"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

</androidx.cardview.widget.CardView>